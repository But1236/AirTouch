<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light soft UI: cooler canvas, brighter solid surfaces, no hard outlines -->
    <DropShadowEffect x:Key="SoftElevatedShadow" Color="#1F2D3D" Direction="270"
                      ShadowDepth="4" BlurRadius="20" Opacity="0.12" />
    <DropShadowEffect x:Key="SoftButtonShadow" Color="#1F2D3D" Direction="270"
                      ShadowDepth="3" BlurRadius="14" Opacity="0.10" />

    <SolidColorBrush x:Key="WindowBrush" Color="#FFDDE3EC" />
    <SolidColorBrush x:Key="BaseBrush" Color="#FFEEF2F7" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#FFEEF2F7" />
    <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#FFF8FAFD" />
    <SolidColorBrush x:Key="InsetBrush" Color="#FFE2E7F0" />
    <SolidColorBrush x:Key="InsetDeepBrush" Color="#FFE2E7F0" />
    <SolidColorBrush x:Key="LogBgBrush" Color="#FFE2E7F0" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="FaintBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="BorderBrushKey" Color="#FFBCC6D4" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFF7FAFD" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FFE4EAF3" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFD97706" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="QrTrayBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InsetStrokeBrush" Color="#14000000" />
</ResourceDictionary>
