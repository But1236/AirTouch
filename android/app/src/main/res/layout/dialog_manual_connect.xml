<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/at_space_l">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manual_dialog_title"
        android:textColor="@color/at_text"
        android:textSize="@dimen/at_text_body" />

    <TextView
        style="@style/Widget.AirTouch.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_m"
        android:text="@string/manual_host_label" />

    <EditText
        android:id="@+id/edit_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/manual_host_label"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:textColor="@color/at_text"
        android:textColorHint="@color/at_text_dim" />

    <TextView
        style="@style/Widget.AirTouch.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_s"
        android:text="@string/manual_port_label" />

    <EditText
        android:id="@+id/edit_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/manual_port_label"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLines="1"
        android:textColor="@color/at_text"
        android:textColorHint="@color/at_text_dim" />

    <TextView
        style="@style/Widget.AirTouch.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_s"
        android:text="@string/manual_token_label" />

    <EditText
        android:id="@+id/edit_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/manual_token_label"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/at_text"
        android:textColorHint="@color/at_text_dim" />

    <TextView
        android:id="@+id/manual_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_s"
        android:textColor="@color/at_error"
        android:textSize="@dimen/at_text_small"
        android:visibility="gone" />
</LinearLayout>
