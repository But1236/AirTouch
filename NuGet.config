<?xml version="1.0" encoding="utf-8"?>
<!--
  包源配置。默认同时使用两个源：
    * nuget.org        —— 正常联网环境直接从这里还原；
    * ./.nuget-local   —— 可选的离线包目录，由 tools/fetch-nuget.mjs 生成（默认不存在，被 .gitignore 忽略）。
  离线目录不存在时不影响还原；只有内网/无外网环境才需要先跑一次 fetch-nuget.mjs。
-->
<configuration>
  <config>
    <!-- 依赖缓存放在仓库内，避免污染用户目录 -->
    <add key="globalPackagesFolder" value=".\.nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="offline-local" value=".\.nuget-local" />
  </packageSources>
</configuration>
