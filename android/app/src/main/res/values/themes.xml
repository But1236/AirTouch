<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      主题选择说明：
      使用 Material3（material:1.12.0 提供 Theme.Material3.*），但下面把关键颜色属性
      全部显式覆盖为 @color/... 常量，因此不依赖任何生成的 Material3 调色板资源
      （如 md_theme_* 等），把编译期资源缺失的风险降到最低。
      同时覆盖 Material 组件依赖的 colorPrimary / colorOnPrimary / colorSurface / colorOnSurface。

      注意：这里只写 android:colorBackground，不写不带 android: 前缀的 colorBackground。
      Material 组件库定义了 colorOnBackground 与 colorBackgroundFloating，但**没有**定义
      colorBackground（框架里已有 android:colorBackground），写非 android: 版本会导致
      aapt2 链接失败：attr/colorBackground not found。
    -->
    <style name="Theme.AirTouch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/at_primary</item>
        <item name="colorOnPrimary">@color/at_on_primary</item>
        <item name="colorPrimaryContainer">@color/at_primary</item>
        <item name="colorOnPrimaryContainer">@color/at_on_primary</item>
        <item name="colorSecondary">@color/at_secondary</item>
        <item name="colorOnSecondary">@color/at_bg</item>
        <item name="colorSurface">@color/at_surface</item>
        <item name="colorOnSurface">@color/at_text</item>
        <item name="colorSurfaceVariant">@color/at_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/at_text_dim</item>
        <item name="colorOnBackground">@color/at_text</item>
        <item name="colorError">@color/at_error</item>
        <item name="colorOnError">@color/at_on_primary</item>
        <item name="colorOutline">@color/at_button_stroke</item>
        <item name="android:colorBackground">@color/at_bg</item>

        <!-- 强制深色，保证自定义 View 的配色一致 -->
        <item name="isLightTheme">false</item>
        <item name="android:windowBackground">@color/at_bg</item>
        <item name="android:textColorPrimary">@color/at_text</item>
        <item name="android:textColorSecondary">@color/at_text_dim</item>
        <item name="android:statusBarColor">@color/at_bg</item>
        <item name="android:navigationBarColor">@color/at_bg</item>
    </style>

    <!--
      旧版 View/XML 界面的 Widget.AirTouch.* 控件样式已随旧版 UI 一同删除。
      现在只保留 application 级主题（RedesignActivity 用平台 NoActionBar 主题覆盖）。
    -->
</resources>
