<?xml version="1.0" encoding="utf-8"?>
<!--
  诊断页：一键画圆测试。
  刻意保持简单：左边一个圆贴住「左+上+下」三条边，右边一个圆贴住「右+上+下」三条边，
  用户只盯着 PC 上的光标看是否停顿，测试结束后看下面回传的统计与结论。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/at_space_s">

        <!--
          按钮放在最上面：早期版本把长说明 + 三组单选框排在前面，按钮被挤到首屏之外，
          用户以为「诊断页没有画圆按钮」。现在先给按钮，再给参数，最后才是说明与统计。
        -->
        <LinearLayout
            style="@style/Widget.AirTouch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/button_run_test"
                style="@style/Widget.AirTouch.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:text="@string/diag_start" />

            <TextView
                android:id="@+id/plan_text"
                style="@style/Widget.AirTouch.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_s"
                android:text="@string/diag_plan_unknown" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AirTouch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/at_space_s"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.AirTouch.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_intro_short"
                android:textColor="@color/at_text" />

            <TextView
                style="@style/Widget.AirTouch.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_xs"
                android:text="@string/diag_mode_title" />

            <RadioGroup
                android:id="@+id/mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_absolute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/diag_mode_absolute"
                    android:textColor="@color/at_text" />

                <RadioButton
                    android:id="@+id/radio_relative"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diag_mode_relative"
                    android:textColor="@color/at_text" />
            </RadioGroup>

            <TextView
                style="@style/Widget.AirTouch.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_xs"
                android:text="@string/diag_hz_title" />

            <RadioGroup
                android:id="@+id/hz_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_hz60"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diag_hz_60"
                    android:textColor="@color/at_text" />

                <RadioButton
                    android:id="@+id/radio_hz100"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/diag_hz_100"
                    android:textColor="@color/at_text" />

                <RadioButton
                    android:id="@+id/radio_hz144"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diag_hz_144"
                    android:textColor="@color/at_text" />
            </RadioGroup>

            <TextView
                style="@style/Widget.AirTouch.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_xs"
                android:text="@string/diag_circle_title" />

            <RadioGroup
                android:id="@+id/circle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_ms1200"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diag_circle_fast"
                    android:textColor="@color/at_text" />

                <RadioButton
                    android:id="@+id/radio_ms2400"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/diag_circle_normal"
                    android:textColor="@color/at_text" />

                <RadioButton
                    android:id="@+id/radio_ms4800"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diag_circle_slow"
                    android:textColor="@color/at_text" />
            </RadioGroup>

            <TextView
                style="@style/Widget.AirTouch.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_xs"
                android:text="@string/diag_intro" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AirTouch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/at_space_s"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/diag_idle"
                android:textColor="@color/at_text"
                android:textSize="@dimen/at_text_small" />

            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_xs"
                android:fontFamily="monospace"
                android:text="@string/diag_result_hint"
                android:textColor="@color/at_secondary"
                android:textSize="@dimen/at_text_small" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AirTouch.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/at_space_s"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trust_info"
                style="@style/Widget.AirTouch.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_trust_info_placeholder" />

            <Button
                android:id="@+id/button_reset_trust"
                style="@style/Widget.AirTouch.ToolbarButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/at_space_xs"
                android:text="@string/diag_reset_trust" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
