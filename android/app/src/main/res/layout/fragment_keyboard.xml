<?xml version="1.0" encoding="utf-8"?>
<!--
  竖屏键盘页。

  布局分四层：功能栏（两行）→ 提示文字 → 候选条 → 键帽阵列。

  功能栏为什么是两行：需求写的是「左侧 Esc + 切换、中间滑条、右侧 Delete + prtsc」，
  但 360dp 宽的屏幕上是放不下的 —— 五个按钮加一条能用的滑条至少需要 300dp 以上，
  滑条会被挤到只剩几十 dp，左右都按不准。因此保留同样的左右分组，把它们放进第一行，
  滑条单独占第二行（宽度吃满，反而更符合「滑动」的手感），「全屏」放在它右端。

  滑条只做**左右**：上下轴整个去掉了（原来是十字摇杆，太矮、上下滑容易误触）。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/keyboard_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 第一行：左侧 Esc + 布局切换 + 纯文本输入，右侧 Del + prtsc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_esc"
                style="@style/Widget.AirTouch.KeyBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/at_keybar_button_esc_width"
                android:text="@string/keyboard_key_esc" />

            <Button
                android:id="@+id/button_layout_switch"
                style="@style/Widget.AirTouch.KeyBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/at_space_s"
                android:minWidth="@dimen/at_keybar_button_switch_width"
                tools:text="9键" />

            <!--
              「纯文本输入框」入口：九键打大段文字时不够聪明，这里给一条逃生通道
              （弹窗里刻意用系统输入法，方便多行编辑与粘贴）。
            -->
            <Button
                android:id="@+id/button_text_sender"
                style="@style/Widget.AirTouch.KeyBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/at_space_s"
                android:minWidth="@dimen/at_keybar_button_text_width"
                android:text="@string/keyboard_btn_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/button_delete"
                style="@style/Widget.AirTouch.KeyBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/at_keybar_button_del_width"
                android:text="@string/keyboard_key_delete" />

            <Button
                android:id="@+id/button_prtsc"
                style="@style/Widget.AirTouch.KeyBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/at_space_s"
                android:minWidth="@dimen/at_keybar_button_prtsc_width"
                android:text="@string/keyboard_key_prtsc" />
        </LinearLayout>

        <!-- 第二行：一字滑条（只做左右） + 全屏展开 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/at_space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.airtouch.app.input.OneLineDPadView
                android:id="@+id/dpad_slider"
                android:layout_width="0dp"
                android:layout_height="@dimen/at_keybar_button_height"
                android:layout_weight="1"
                android:contentDescription="@string/keyboard_dpad_description" />

            <Button
                android:id="@+id/button_fullscreen"
                style="@style/Widget.AirTouch.KeyBarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/at_space_s"
                android:minWidth="@dimen/at_keybar_button_fullscreen_width"
                android:text="@string/keyboard_btn_fullscreen" />
        </LinearLayout>
    </LinearLayout>

    <!--
      提示文字占住功能栏与候选条之间剩下的空间：竖屏下键盘按固定宽高比定高，这块空白本来就会空着，
      放「当前布局 / 粘滞键状态 / 连接状态」的说明比留白有用得多。
    -->
    <TextView
        android:id="@+id/keyboard_hint"
        style="@style/Widget.AirTouch.Label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:paddingStart="@dimen/at_space_l"
        android:paddingEnd="@dimen/at_space_l"
        android:text="@string/keyboard_hint_qwerty"
        app:layout_constraintBottom_toTopOf="@id/candidate_strip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/keyboard_toolbar" />

    <!--
      候选条：九键拼音的组合串 + 候选芯片（标点面板也复用它）。Qwerty 布局下整条隐藏。
      放在键盘正上方而不是提示文字上方 —— 手机输入法的候选条就贴着键盘，手指移动距离最短。
    -->
    <LinearLayout
        android:id="@+id/candidate_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_at_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/at_space_s"
        android:paddingTop="@dimen/at_space_xs"
        android:paddingEnd="@dimen/at_space_s"
        android:paddingBottom="@dimen/at_space_xs"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/keyboard_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/candidate_composition"
            style="@style/Widget.AirTouch.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/at_candidate_label_width"
            android:textColor="@color/at_primary"
            tools:text="64'426" />

        <HorizontalScrollView
            android:id="@+id/candidate_scroller"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidate_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!--
      高度用 wrap_content：KeyboardView 自己按布局的宽高比算出「合理高度」，
      这样竖屏上键帽不会被拉成又窄又高的长条。
    -->
    <com.airtouch.app.input.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_at_card"
        android:padding="@dimen/at_space_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
