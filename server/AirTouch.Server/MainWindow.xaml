<Window x:Class="AirTouch.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirTouch 服务端" Height="560" Width="880"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="NeuTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared template for the compact log lines in both the console card and the expanded view -->
        <DataTemplate x:Key="LogLineTemplate">
            <Grid Margin="0,0,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Timestamp, StringFormat=[HH:mm:ss]}"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="11" Foreground="{DynamicResource FaintBrush}"
                           VerticalAlignment="Top" Margin="0,1,8,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource LevelTag}" Margin="0,1,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- ============================ CONSOLE ============================ -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: brand + status capsule + theme/settings -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AirTouch" Style="{DynamicResource NeuBrand}" />
                    <TextBlock Text="服务端" Style="{DynamicResource NeuBrandSub}" Margin="7,1,0,0" />
                </StackPanel>

                <ContentControl Grid.Column="1" Style="{DynamicResource NeuInsetPill}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="248" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Grid.Column="0" Width="8" Height="8"
                                 Fill="{DynamicResource MutedBrush}" Margin="14,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{DynamicResource NeuValue}"
                                   Text="等待手机接入..." HorizontalAlignment="Left" />
                    </Grid>
                </ContentControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnTheme" Style="{DynamicResource NeuButton}" Width="36" Height="36"
                            Click="OnToggleThemeClick" ToolTip="切换深色 / 浅色模式">
                        <Path x:Name="ThemeIcon" Data="{DynamicResource IcoSun}" Width="17" Height="17"
                              Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" />
                    </Button>
                    <Button x:Name="BtnSettings" Style="{DynamicResource NeuButton}" Width="36" Height="36"
                            Margin="4,0,0,0" Click="OnOpenSettingsClick" ToolTip="设置中心">
                        <Path Data="{StaticResource IcoWrench}" Width="17" Height="17" Stretch="Uniform"
                              Fill="{DynamicResource TextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: fixed 320px pairing dock + elastic workspace -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left (fixed width): QR pairing -->
                <ContentControl Grid.Column="0" Style="{DynamicResource NeuPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="扫码配对新手机" Style="{DynamicResource NeuSection}"
                                   HorizontalAlignment="Center" />

                        <Grid Grid.Row="1" Margin="0,8,0,6">
                            <ContentControl Style="{DynamicResource NeuInsetQr}"
                                            Width="244" Height="244"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{DynamicResource QrTrayBrush}" CornerRadius="10" Padding="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="QrImage" Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True">
                                        <Image.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="保存二维码到文件..." Click="OnSaveQrClick" />
                                            </ContextMenu>
                                        </Image.ContextMenu>
                                    </Image>
                                </Border>
                            </ContentControl>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="打开 App 扫码，同局域网自动直连"
                                   Style="{DynamicResource NeuHint}" HorizontalAlignment="Center" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="BtnCopyUrl" Style="{DynamicResource NeuButton}" Width="122" Height="36"
                                    Click="OnCopyUrlClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoLink}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Margin="0,0,8,0" />
                                    <TextBlock Text="复制链接" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRefreshToken" Style="{DynamicResource NeuButton}" Width="106" Height="36"
                                    Margin="10,0,0,0" Click="OnRefreshTokenClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoRefresh}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Margin="0,0,8,0" />
                                    <TextBlock Text="刷新" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <!-- Right: elastic workspace -->
                <Grid Grid.Column="1" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- File transfer: one restrained row -->
                    <ContentControl Grid.Row="0" Style="{DynamicResource NeuPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSendFile" Style="{DynamicResource NeuButton}"
                                    Width="150" Height="34" Click="OnSendFileClick"
                                    ToolTip="选择文件并发送到已连接的手机">
                                <TextBlock Text="发送文件" />
                            </Button>

                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <ContentControl Style="{DynamicResource NeuInsetBar}" Height="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtDownload" Style="{DynamicResource NeuMono}"
                                                   Margin="10,0,4,0" VerticalAlignment="Center" Text="—" />
                                        <Button x:Name="BtnOpenDownload" Grid.Column="1"
                                                Style="{DynamicResource NeuTextButton}" Width="28" Height="28"
                                                Padding="0" Margin="0,0,3,0"
                                                Click="OnOpenDownloadClick" ToolTip="打开接收目录">
                                            <Path Data="{StaticResource IcoFolder}" Width="15" Height="15"
                                                  Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" />
                                        </Button>
                                    </Grid>
                                </ContentControl>
                            </Grid>

                            <ProgressBar x:Name="SendProgress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                         Style="{DynamicResource NeuProgress}" Minimum="0" Maximum="100"
                                         Value="0" VerticalAlignment="Center" />
                        </Grid>
                    </ContentControl>

                    <!-- Trusted devices -->
                    <ContentControl Grid.Row="1" Style="{DynamicResource NeuPanel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="TrustedTitle" Text="已信任设备 (0)"
                                           Style="{DynamicResource NeuSection}" VerticalAlignment="Center" />
                                <Button x:Name="BtnRevokeAll" Style="{DynamicResource NeuDangerTextButton}"
                                        Content="清除全部" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnRevokeAllClick" />
                            </Grid>
                            <ContentControl Grid.Row="1" Style="{DynamicResource NeuInset}" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock x:Name="EmptyDevices" Text="暂无已信任设备"
                                               Foreground="{DynamicResource FaintBrush}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ListBox x:Name="TrustedList" Background="Transparent" BorderThickness="0"
                                             Margin="6,6,4,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False">
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource NeuThinScrollBar}" />
                                        </ListBox.Resources>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NeuRow}" Height="44" Padding="10,6" Margin="0,0,4,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource IcoMobile}" Width="16" Height="16"
                                                              Stretch="Uniform" Stroke="{DynamicResource InfoBrush}"
                                                              StrokeThickness="1.6" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource FaintBrush}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="最近 {0:MM-dd HH:mm} · 连接 {1} 次">
                                                                        <Binding Path="LastSeenUtc" />
                                                                        <Binding Path="SessionCount" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button x:Name="BtnRevokeItem" Grid.Column="2" Tag="{Binding}"
                                                                Click="OnRevokeItemClick" Style="{DynamicResource NeuButton}"
                                                                Width="24" Height="24" ToolTip="移除这台设备">
                                                            <Path Data="{StaticResource IcoClose}" Width="11" Height="11"
                                                                  Stretch="Uniform" Stroke="{DynamicResource ErrorBrush}"
                                                                  StrokeThickness="2" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </ContentControl>

                    <!-- Console messages: always present, grows with the window -->
                    <ContentControl Grid.Row="2" Style="{DynamicResource NeuPanel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="控制台消息" Style="{DynamicResource NeuSection}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnClearConsole" Style="{DynamicResource NeuTextButton}"
                                            Content="清空" FontSize="11" Click="OnClearConsoleClick" />
                                    <Button x:Name="BtnExpandConsole" Style="{DynamicResource NeuTextButton}"
                                            Width="28" Height="24" Click="OnExpandConsoleClick" ToolTip="展开全屏日志">
                                        <Path Data="{StaticResource IcoExpand}" Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ContentControl Grid.Row="1" Style="{DynamicResource NeuInsetTerminal}" Margin="0,8,0,0">
                                <ListBox x:Name="ConsoleList" Background="Transparent" BorderThickness="0"
                                         Margin="8,6,4,6" ItemTemplate="{StaticResource LogLineTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource NeuThinScrollBar}" />
                                    </ListBox.Resources>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </ContentControl>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================ OVERLAYS ============================ -->
        <Grid x:Name="OverlayDim" Background="#990E1013" Visibility="Collapsed"
              Panel.ZIndex="10" MouseLeftButtonDown="OnOverlayClick" />

        <!-- Settings center -->
        <ContentControl x:Name="SettingsModal" Style="{DynamicResource NeuPanel}" Visibility="Collapsed"
                        Panel.ZIndex="11" Width="700" Height="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="158" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left navigation -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IcoWrench}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="设置中心" Style="{DynamicResource NeuSection}" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <RadioButton x:Name="TabAppearance" GroupName="SettingsTabs"
                                     Style="{DynamicResource NeuNavRadio}" Content="外观与主题"
                                     IsChecked="True" Checked="OnSettingsTabChecked" />
                        <RadioButton x:Name="TabControl" GroupName="SettingsTabs"
                                     Style="{DynamicResource NeuNavRadio}" Content="控制与硬件"
                                     Checked="OnSettingsTabChecked" />
                        <RadioButton x:Name="TabNetwork" GroupName="SettingsTabs"
                                     Style="{DynamicResource NeuNavRadio}" Content="网络与安全"
                                     Checked="OnSettingsTabChecked" />
                    </StackPanel>
                </Grid>

                <!-- Right content -->
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Button x:Name="BtnCloseSettings" Style="{DynamicResource NeuTextButton}" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                            Click="OnCloseOverlayClick" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,28,0,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource NeuThinScrollBar}" />
                        </ScrollViewer.Resources>
                        <Grid>
                            <!-- Tab 1: appearance -->
                            <StackPanel x:Name="AppearancePanel">
                                <TextBlock Text="界面外观" Style="{DynamicResource NeuSection}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDark" GroupName="ThemeChoice"
                                                 Style="{DynamicResource NeuNavRadio}" Content="深色新拟态"
                                                 IsChecked="True" Checked="OnThemeChoiceChecked" />
                                    <RadioButton x:Name="ThemeLight" GroupName="ThemeChoice"
                                                 Style="{DynamicResource NeuNavRadio}" Content="浅色新拟态"
                                                 Checked="OnThemeChoiceChecked" />
                                    <RadioButton x:Name="ThemeSystem" GroupName="ThemeChoice"
                                                 Style="{DynamicResource NeuNavRadio}" Content="跟随系统"
                                                 Checked="OnThemeChoiceChecked" />
                                </StackPanel>

                                <TextBlock Text="强调色（Accent Color）" Style="{DynamicResource NeuSection}"
                                           Margin="0,22,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AccentAmber" Style="{DynamicResource NeuColorRadio}" Background="#FFF5B841"
                                                 Tag="amber" Checked="OnAccentChecked" />
                                    <RadioButton x:Name="AccentCyan" Style="{DynamicResource NeuColorRadio}" Background="#FF38BDF8"
                                                 Tag="cyan" Checked="OnAccentChecked" Margin="10,0,0,0" />
                                    <RadioButton x:Name="AccentMint" Style="{DynamicResource NeuColorRadio}" Background="#FF34D399"
                                                 Tag="mint" Checked="OnAccentChecked" Margin="10,0,0,0" />
                                    <RadioButton x:Name="AccentCoral" Style="{DynamicResource NeuColorRadio}" Background="#FFFB7185"
                                                 Tag="coral" Checked="OnAccentChecked" Margin="10,0,0,0" />
                                    <RadioButton x:Name="AccentViolet" Style="{DynamicResource NeuColorRadio}" Background="#FFA78BFA"
                                                 Tag="violet" Checked="OnAccentChecked" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{DynamicResource NeuHint}" Margin="0,14,0,0"
                                           Text="强调色会立即作用于呼吸指示灯、图标高光与选中态；浅色模式下琥珀金自动加深为暖琥珀。" />
                            </StackPanel>

                            <!-- Tab 2: control & hardware -->
                            <StackPanel x:Name="ControlPanel" Visibility="Collapsed">
                                <TextBlock Text="双指缩放偏好" Style="{DynamicResource NeuSection}" Margin="0,0,0,8" />
                                <ComboBox x:Name="CmbZoomMode" Width="240" Height="34"
                                          HorizontalAlignment="Left" Style="{DynamicResource NeuComboBox}"
                                          ItemContainerStyle="{StaticResource NeuComboBoxItem}"
                                          SelectionChanged="OnZoomModeChanged" />

                                <TextBlock Text="触控硬件状态" Style="{DynamicResource NeuSection}"
                                           Margin="0,22,0,8" />
                                <ContentControl Style="{DynamicResource NeuInset}">
                                    <StackPanel Margin="10,8">
                                        <TextBlock x:Name="TxtZoom" Style="{DynamicResource NeuValue}"
                                                   TextWrapping="Wrap" Text="—" />
                                        <TextBlock x:Name="TxtZoomHint" Style="{DynamicResource NeuHint}"
                                                   Margin="0,8,0,0" Text="—" />
                                    </StackPanel>
                                </ContentControl>
                                <Button x:Name="BtnZoomRefresh" Style="{DynamicResource NeuButton}"
                                        Content="重新检测触控能力" Width="170" Height="34"
                                        HorizontalAlignment="Right" Margin="0,12,0,0"
                                        Click="OnZoomRefreshClick" />
                            </StackPanel>

                            <!-- Tab 3: network & security -->
                            <StackPanel x:Name="NetworkPanel" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="本机 IP" Style="{DynamicResource NeuLabel}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbAddress" Height="30" Style="{DynamicResource NeuComboBox}"
                                                  ItemContainerStyle="{StaticResource NeuComboBoxItem}"
                                                  SelectionChanged="OnAddressChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="端口" Style="{DynamicResource NeuLabel}" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtPort" Style="{StaticResource NeuTextBox}" Text="8443" />
                                            <Button x:Name="BtnApplyPort" Grid.Column="1" Style="{DynamicResource NeuButton}"
                                                    Width="60" Height="30" Margin="6,0,0,0" Content="应用"
                                                    Click="OnApplyPortClick" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="接收目录" Style="{DynamicResource NeuLabel}" Margin="0,14,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDownloadDir" Style="{StaticResource NeuTextBox}" />
                                    <Button x:Name="BtnBrowseDownload" Grid.Column="1" Style="{DynamicResource NeuButton}"
                                            Width="52" Height="30" Margin="6,0,0,0" Content="浏览"
                                            Click="OnBrowseDownloadClick" />
                                    <Button x:Name="BtnApplyDownload" Grid.Column="2" Style="{DynamicResource NeuButton}"
                                            Width="52" Height="30" Margin="6,0,0,0" Content="应用"
                                            Click="OnApplyDownloadClick" />
                                </Grid>

                                <TextBlock Text="安全凭据" Style="{DynamicResource NeuSection}"
                                           Margin="0,20,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="证书指纹" Style="{DynamicResource NeuLabel}" Margin="0,0,0,4" />
                                        <ContentControl Style="{DynamicResource NeuInset}">
                                            <TextBlock x:Name="TxtFingerprint" Style="{DynamicResource NeuMono}"
                                                       Margin="9,7" />
                                        </ContentControl>
                                        <TextBlock Text="服务器身份 sid" Style="{DynamicResource NeuLabel}"
                                                   Margin="0,12,0,4" />
                                        <ContentControl Style="{DynamicResource NeuInsetBar}" Height="30">
                                            <TextBlock x:Name="TxtSid" Style="{DynamicResource NeuMono}" Margin="9,5" />
                                        </ContentControl>
                                        <TextBlock Text="指纹固定值 fp" Style="{DynamicResource NeuLabel}"
                                                   Margin="0,12,0,4" />
                                        <ContentControl Style="{DynamicResource NeuInsetBar}" Height="30">
                                            <TextBlock x:Name="TxtPin" Style="{DynamicResource NeuMono}" Margin="9,5" />
                                        </ContentControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Button x:Name="BtnCopyFingerprint" Style="{DynamicResource NeuButton}"
                                                Width="30" Height="30" Click="OnCopyFingerprintClick"
                                                ToolTip="复制证书指纹">
                                            <Path Data="{StaticResource IcoCopy}" Width="14" Height="14"
                                                  Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" />
                                        </Button>
                                        <Button x:Name="BtnCopyPin" Style="{DynamicResource NeuButton}"
                                                Width="30" Height="30" Margin="0,20,0,0" Click="OnCopyPinClick"
                                                ToolTip="复制固定值 fp">
                                            <Path Data="{StaticResource IcoCopy}" Width="14" Height="14"
                                                  Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="连接管理" Style="{DynamicResource NeuSection}"
                                           Margin="0,20,0,8" />
                                <ContentControl Style="{DynamicResource NeuInsetBar}" Height="30">
                                    <TextBlock x:Name="TxtBanned" Style="{DynamicResource NeuMono}"
                                               Margin="9,5" Text="无" />
                                </ContentControl>
                                <Button x:Name="BtnReset" Style="{DynamicResource NeuButton}"
                                        Content="断开并重置信任" Width="150" Height="32"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnResetClick" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ContentControl>

        <!-- Expanded full log -->
        <ContentControl x:Name="ConsoleExpanded" Style="{DynamicResource NeuPanel}" Visibility="Collapsed"
                        Panel.ZIndex="12" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="运行日志（全屏）" Style="{DynamicResource NeuSection}" FontSize="14"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnCloseConsoleExpanded" Style="{DynamicResource NeuTextButton}"
                            Content="✕" HorizontalAlignment="Right" Click="OnCloseConsoleExpandedClick" />
                </Grid>
                <ContentControl Grid.Row="1" Style="{DynamicResource NeuInsetTerminal}" Margin="0,8,0,0">
                    <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Margin="10,8,4,8"
                             ItemTemplate="{StaticResource LogLineTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource NeuThinScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ContentControl>
            </Grid>
        </ContentControl>

        <!-- Toast -->
        <Border x:Name="Toast" Panel.ZIndex="20" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,18,0"
                Background="{DynamicResource RaisedBrush}" CornerRadius="16" Padding="16,8"
                BorderThickness="0" Effect="{DynamicResource SoftElevatedShadow}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IcoCheck}" Width="13" Height="13" Stretch="Uniform"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                      Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Text="" Foreground="{DynamicResource TextBrush}" FontSize="12.5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
