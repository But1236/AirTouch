<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline build configuration for this checkout.

  Agent sessions on this repo run in a sandbox whose process token is stripped, so Schannel fails
  there with SEC_E_NO_CREDENTIALS and nuget.org is unreachable. A normal desktop session is NOT
  affected. So that a sandboxed agent can still build, packages are vendored into .nuget-local by
  tools/fetch-nuget.mjs and consumed from this folder feed. The global packages folder is also
  redirected into the checkout so a build never needs to write outside the repository - which the
  sandbox cannot do either.

  On a machine with working nuget.org access you can simply delete the <clear /> element below (or
  this whole file) and run `dotnet restore` against the public feed as usual.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".\.nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="offline-local" value=".\.nuget-local" />
  </packageSources>
</configuration>
