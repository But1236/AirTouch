<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark soft UI: same vertical-only diffuse shadow logic, no bright hairlines -->
    <DropShadowEffect x:Key="SoftElevatedShadow" Color="#000000" Direction="270"
                      ShadowDepth="4" BlurRadius="20" Opacity="0.35" />
    <DropShadowEffect x:Key="SoftButtonShadow" Color="#000000" Direction="270"
                      ShadowDepth="3" BlurRadius="14" Opacity="0.28" />

    <SolidColorBrush x:Key="WindowBrush" Color="#FF191C21" />
    <SolidColorBrush x:Key="BaseBrush" Color="#FF23272F" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#FF23272F" />
    <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#FF2C313B" />
    <SolidColorBrush x:Key="InsetBrush" Color="#FF15181D" />
    <SolidColorBrush x:Key="InsetDeepBrush" Color="#FF15181D" />
    <!-- NeuProgress 的进度槽背景（App.xaml 的 NeuProgress 模板一直在引用它，但两个主题字典都漏了定义，
         结果是槽体透明、只剩一根拖动条）。取值与 InsetDeepBrush 一致。 -->
    <SolidColorBrush x:Key="InnerDarkBrush" Color="#FF15181D" />
    <SolidColorBrush x:Key="LogBgBrush" Color="#FF15181D" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE6E9F0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8A90A0" />
    <SolidColorBrush x:Key="FaintBrush" Color="#FF727988" />
    <SolidColorBrush x:Key="BorderBrushKey" Color="#FF3A414D" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FF2B3038" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FF1B1F25" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF6FA8FF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFF5B841" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFE8656C" />
    <SolidColorBrush x:Key="QrTrayBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="InsetStrokeBrush" Color="#14FFFFFF" />
</ResourceDictionary>
