<?xml version="1.0" encoding="utf-8"?>
<!--
  「纯文本输入框」对话框的布局。

  这是整个 App 里**唯一**刻意使用系统输入法的地方：九键打大段文字不够聪明，这里让用户用手机
  自带的输入法（联想、语音、粘贴、多行编辑）打完一整段，再整段发到电脑上。自绘键盘本身从不
  调起系统输入法，不要把这个例外推广出去。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/at_space_l"
    android:paddingTop="@dimen/at_space_s"
    android:paddingEnd="@dimen/at_space_l"
    android:paddingBottom="@dimen/at_space_s">

    <TextView
        style="@style/Widget.AirTouch.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/keyboard_text_sender_hint" />

    <EditText
        android:id="@+id/text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_s"
        android:gravity="top|start"
        android:hint="@string/keyboard_text_sender_placeholder"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="4"
        android:maxLines="8"
        android:scrollbars="vertical"
        android:textColor="@color/at_text"
        android:textColorHint="@color/at_text_dim"
        tools:text="你好，这是一段要打到电脑上的文字。" />

    <TextView
        android:id="@+id/text_counter"
        style="@style/Widget.AirTouch.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_xs"
        android:gravity="end"
        tools:text="已输入 12 个字" />
</LinearLayout>
