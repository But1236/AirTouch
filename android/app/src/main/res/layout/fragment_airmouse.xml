<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sensitivity_row"
        style="@style/Widget.AirTouch.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/Widget.AirTouch.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/airmouse_sensitivity" />

        <SeekBar
            android:id="@+id/sensitivity_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/at_space_s"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/sensitivity_value"
            style="@style/Widget.AirTouch.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toggle_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_s"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sensitivity_row">

        <CheckBox
            android:id="@+id/check_invert_x"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/airmouse_invert_x"
            android:textColor="@color/at_text" />

        <CheckBox
            android:id="@+id/check_invert_y"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/airmouse_invert_y"
            android:textColor="@color/at_text" />
    </LinearLayout>

    <!--
      当前模式行：明确写清「移动光标」还是「滚轮」。
      滚轮模式下陀螺仪不再移动光标，如果没有这一行，用户会以为空中鼠标坏了。
    -->
    <TextView
        android:id="@+id/sensor_mode"
        style="@style/Widget.AirTouch.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_s"
        android:gravity="center"
        android:text="@string/airmouse_mode_move"
        android:textColor="@color/at_text_dim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggle_row" />

    <TextView
        android:id="@+id/sensor_status"
        style="@style/Widget.AirTouch.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/at_space_xs"
        android:gravity="center"
        android:text="@string/airmouse_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sensor_mode" />

    <!-- 悬浮复位按钮：底部靠右，可拖动（OnTouchListener），复位同时清空引擎累计余量 -->
    <TextView
        android:id="@+id/button_reset_float"
        style="@style/Widget.AirTouch.FloatingReset"
        android:layout_width="@dimen/at_reset_button_size"
        android:layout_height="@dimen/at_reset_button_size"
        android:layout_marginEnd="@dimen/at_space_l"
        android:layout_marginBottom="@dimen/at_space_l"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/airmouse_reset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
