<Application x:Class="AirTouch.Server.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Accent is user-selectable and survives theme swaps; App.xaml.cs updates AccentColor. -->
        <Color x:Key="AccentColor">#FFF5B841</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />

        <!-- Theme-owned brushes AND colors both live in Themes/Dark.xaml / Themes/Light.xaml.
             Swapping the dictionary re-resolves every DynamicResource at once; brushes defined here
             with nested DynamicResource Colors were the reason light mode kept the dark base. -->

        <!-- ================= Icons (24x24) ================= -->
        <StreamGeometry x:Key="IcoWrench">M22.7 19 L13.6 9.9 C14.5 7.6 14 4.9 12.1 3 C10.1 1 7.1 0.6 4.7 1.7 L9 6 L6 9 L1.7 4.7 C0.6 7.1 1 10.1 3 12.1 C4.9 14 7.6 14.5 9.9 13.6 L19 22.7 C19.4 23.1 20 23.1 20.4 22.7 L22.7 20.4 C23.1 20 23.1 19.4 22.7 19 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoFolder">M3,6 H9 L11,8 H21 V19 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoCopy">M8,8 H19 V19 H8 Z M5,16 H4 V5 H15 V6</StreamGeometry>
        <StreamGeometry x:Key="IcoRefresh">M20,8 A8,8 0 1 0 21,13 M20,4 V8 H16</StreamGeometry>
        <StreamGeometry x:Key="IcoMobile">M7,2 H17 V22 H7 Z M10,19 H14</StreamGeometry>
        <StreamGeometry x:Key="IcoClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
        <StreamGeometry x:Key="IcoLink">M10,14 A4,4 0 0 0 16,14 L18,12 A4,4 0 0 0 12,6 L10,8 M14,10 A4,4 0 0 0 8,10 L6,12 A4,4 0 0 0 12,18 L14,16</StreamGeometry>
        <StreamGeometry x:Key="IcoCheck">M4,12 L9,17 L20,6</StreamGeometry>
        <StreamGeometry x:Key="IcoSun">M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,1 V3 M12,21 V23 M1,12 H3 M21,12 H23 M4.2,4.2 L5.7,5.7 M18.3,18.3 L19.8,19.8 M19.8,4.2 L18.3,5.7 M5.7,18.3 L4.2,19.8</StreamGeometry>
        <StreamGeometry x:Key="IcoMoon">M20,14.5 A8.5,8.5 0 1 1 9.5,4 A7,7 0 0 0 20,14.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoExpand">M4,9 V4 H9 M20,15 V20 H15 M4,4 L9,9 M20,20 L15,15</StreamGeometry>

        <!-- ================= Typography ================= -->
        <Style x:Key="NeuBrand" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NeuBrandSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NeuSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="NeuLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NeuHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style x:Key="NeuValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NeuMono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <!-- Colored level tag used by the console -->
        <Style x:Key="LevelTag" TargetType="TextBlock">
            <Setter Property="Text" Value="信息" />
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter Property="Text" Value="警告" />
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Text" Value="错误" />
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= Raised panel ================= -->
        <Style x:Key="NeuPanel" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Margin="5">
                            <!-- Empty shadow caster: the effect never touches the content, so text stays crisp. -->
                            <Border CornerRadius="20" Background="{DynamicResource BaseBrush}"
                                    Effect="{DynamicResource SoftElevatedShadow}" />
                            <Border CornerRadius="20" Background="{DynamicResource BaseBrush}">
                                <ContentPresenter Margin="16" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeuRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Effect" Value="{DynamicResource SoftButtonShadow}" />
        </Style>

        <!-- ================= Inset slots ================= -->
        <Style x:Key="NeuInset" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="14" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource InsetStrokeBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NeuInsetPill" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="16" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource InsetStrokeBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NeuInsetBar" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="10" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource InsetStrokeBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NeuInsetQr" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="16" Background="{DynamicResource InsetDeepBrush}"
                                BorderBrush="{DynamicResource InsetStrokeBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NeuInsetTerminal" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="12" Background="{DynamicResource LogBgBrush}"
                                BorderBrush="{DynamicResource InsetStrokeBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Soft raised pill / circle button: solid fill, vertical diffuse shadow ================= -->
        <ControlTemplate x:Key="NeuButtonTemplate" TargetType="Button">
            <Border x:Name="Outer" CornerRadius="18" Background="{DynamicResource ButtonSurfaceBrush}"
                    BorderThickness="0" Margin="3" Effect="{DynamicResource SoftButtonShadow}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Outer" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Outer" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="NeuButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource NeuButtonTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Flat text button -->
        <ControlTemplate x:Key="NeuTextButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="NeuTextButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource NeuTextButtonTemplate}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NeuDangerTextButton" TargetType="Button" BasedOn="{StaticResource NeuTextButton}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <!-- Radio used as settings side navigation -->
        <Style x:Key="NeuNavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="12,9" Margin="0,0,0,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InsetBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio used as a color swatch -->
        <Style x:Key="NeuColorRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="30" Height="30">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Ellipse x:Name="Dot" Width="20" Height="20" Fill="{TemplateBinding Background}" Margin="5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="23" />
                                <Setter TargetName="Dot" Property="Height" Value="23" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ComboBox ================= -->
        <ControlTemplate x:Key="NeuComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource RaisedBrush}"
                        BorderThickness="0" Effect="{DynamicResource SoftButtonShadow}">
                    <Grid>
                        <ContentPresenter x:Name="ContentSite" Margin="12,0,32,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" />
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ToggleButton Focusable="False" ClickMode="Press" OverridesDefaultStyle="True"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                       PlacementTarget="{Binding ElementName=Bd}">
                    <Border Background="{DynamicResource RaisedBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                            Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <Style x:Key="NeuComboBox" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource NeuComboBoxTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MaxDropDownHeight" Value="180" />
        </Style>
        <Style x:Key="NeuComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InsetBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Thin 4px scrollbar ================= -->
        <Style x:Key="NeuThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource MutedBrush}" CornerRadius="2" Margin="0,2" Opacity="0.55" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim progress groove -->
        <Style x:Key="NeuProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{DynamicResource InnerDarkBrush}" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
